# ---------------------------------------------------------------------------
# Orbit backoffice web — local development environment.
#
# Copy to .env.local. Vite only exposes variables prefixed VITE_ to the client,
# which is the mechanism that stops a secret being bundled into JavaScript that
# every user downloads. Nothing secret belongs in this file regardless.
# ---------------------------------------------------------------------------

# Where the application sends every request. There are no service URLs in this codebase,
# in any environment — this is the YARP gateway, including for the admin BFF, because
# operations capabilities are the last surface that should have a second door.
#
# Two shapes are supported, and the choice is about what sits in front of the static
# files rather than about the application:
#
#   /api                            A same-origin path, proxied on to VITE_GATEWAY_URL by
#                                   the vite dev server (vite.config.ts) or by nginx
#                                   (nginx.conf.template). No CORS involved.
#
#   https://api.dev.orbit.crokta.com  The gateway itself, called cross-origin. Nothing
#                                   needs to sit in front, but the gateway must list this
#                                   site's origin in CORS__ALLOWEDORIGINS__n or every
#                                   request fails preflight.
#
# Locally the first shape is the useful one: VITE_GATEWAY_URL is read only by the vite
# proxy, never by the application, so it does nothing when the base URL is absolute.
VITE_GATEWAY_URL=http://localhost:8080
VITE_API_BASE_URL=/api

# Shown in the sidebar so an operator can tell at a glance which platform the console is
# wired to. A label only — nothing in the application branches on it.
VITE_ENVIRONMENT=local
VITE_MARKET=lagos

PORT=5174
